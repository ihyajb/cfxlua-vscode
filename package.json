{
  "name": "cfxlua-intellisense-aj",
  "displayName": "FiveM/RedM Lua Type/Native IntelliSense",
  "description": "IntelliSense support for Natives and Types in the Lua Script runtime used by FiveM and RedM.",
  "version": "1.11.33",
  "publisher": "ihyajb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihyajb/cfxlua-vscode"
  },
  "engines": {
    "vscode": "^1.71.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cfxlua.game.rdr3",
        "title": "Use RDR3 natives",
        "category": "CfxLua"
      },
      {
        "command": "cfxlua.game.gtav",
        "title": "Use GTAV natives",
        "category": "CfxLua"
      },
      {
        "command": "cfxlua.game.toggle",
        "title": "Toggle Game (GTAV / RDR3)",
        "category": "CfxLua"
      },
      {
        "command": "cfxlua.natives.find",
        "title": "Find Native",
        "category": "CfxLua"
      },
      {
        "command": "cfxlua.resource.new",
        "title": "New Resource",
        "category": "CfxLua"
      },
      {
        "command": "cfxlua.config.writeLuarc",
        "title": "Write .luarc.json",
        "category": "CfxLua"
      },
      {
        "command": "cfxlua.config.repair",
        "title": "Repair configuration",
        "category": "CfxLua"
      },
      {
        "command": "cfxlua.config.remove",
        "title": "Remove configuration",
        "category": "CfxLua"
      },
      {
        "command": "cfxlua.showLog",
        "title": "Show Log",
        "category": "CfxLua"
      }
    ],
    "snippets": [
      {
        "language": "lua",
        "path": "./snippets/cfxlua.json"
      }
    ],
    "configuration": {
      "title": "CfxLua",
      "properties": {
        "cfxlua.game": {
          "type": "string",
          "scope": "resource",
          "default": "gtav",
          "enum": [
            "gtav",
            "rdr3"
          ],
          "enumDescriptions": [
            "Grand Theft Auto V (FiveM)",
            "Red Dead Redemption 3 (RedM)"
          ],
          "description": "Select which game's native definitions to load."
        },
        "cfxlua.autoConfigure": {
          "type": "string",
          "scope": "window",
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Configure the Lua Language Server only when the workspace contains a resource manifest.",
            "Always configure the Lua Language Server, even outside a Cfx project.",
            "Never configure anything automatically; the CfxLua commands still work."
          ],
          "markdownDescription": "When to configure the Lua Language Server for Cfx development. `auto` leaves unrelated Lua projects alone; use `always` if your resources have no `fxmanifest.lua` where this extension can find one."
        },
        "cfxlua.diagnostics.nativeScope": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "markdownDescription": "Warn when a native is called from a script the manifest loads on the wrong side, such as a client-only native in a `server_scripts` file."
        },
        "cfxlua.diagnostics.manifestKeys": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "markdownDescription": "Warn about keys in `fxmanifest.lua` that look like a misspelling of a known key, such as `client_scrpits`."
        }
      }
    }
  },
  "keywords": [
    "Lua",
    "FiveM",
    "RedM",
    "CFX",
    "IntelliSense",
    "Natives",
    "Types",
    "VS Code"
  ],
  "icon": "logo.png",
  "activationEvents": [
    "onLanguage:lua",
    "workspaceContains:**/fxmanifest.lua",
    "workspaceContains:**/__resource.lua"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "typecheck": "tsc -p . --noEmit",
    "pretest": "yarn run lint && yarn run format",
    "test": "yarn run compile-tests && node --test \"out/test/unit/**/*.test.js\"",
    "format": "biome format --write",
    "lint": "biome check --write",
    "check": "biome ci src"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.11",
    "@types/vscode": "^1.71.0",
    "ts-loader": "^9.3.1",
    "typescript": "^4.7.4",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "extensionDependencies": [
    "sumneko.lua"
  ]
}
